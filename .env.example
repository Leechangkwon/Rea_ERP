# Independent local runtime. Default development keeps the existing local SQLite.
REA_STORAGE=sqlite
REA_PORT=8781
# Existing local account/data file. No automatic upload to Supabase.
REA_SQLITE_FILE=.artifacts/preview.sqlite
# Set this only after confirming the REA Cloudflare hostname. HTTPS origin only.
REA_PUBLIC_ORIGIN=
# Use configure:supabase to save the server key outside the repository (mode 600).
# Set REA_STORAGE=supabase to explicitly select this backend.
SUPABASE_URL=https://bzyvdergqijwswnjvozs.supabase.co
SUPABASE_SECRET_KEY=
# Comma-separated HTTPS host allowlist for explicit external delivery.
OUTBOUND_ALLOWED_HOSTS=
# Server-only bearer secret, referenced by a connection profile.
CONNECTOR_EXAMPLE=
