  "sourceFindings": [
    {
      "scope": "InitializeProgressStatusIconButtonUserAction",
      "finding": "Uses a separate from-slip state model, sets visibility/state/layer handlers and supplies its fragment component. Presence of the handler alone does not prove a particular purchase menu uses it."
    },
    {
      "scope": "initButtonState",
      "finding": "Checks finish_tf in both state_code_list and state_code_auto_list, updates target_slip_flag and refreshes the layer on mode-specific state-code changes. It is UI-state subscription logic, not a remaining-quantity or completion save calculator."
    },
    {
      "scope": "dmc_subscribe_handler",
      "finding": "Also treats change and automatic-change state lists independently and hides the flag if neither has a selected finish state. This is the initial model handler, not evidence that every imported document is completed."
    },
    {
      "scope": "setProgressStatusButton",
      "finding": "After import, initializes and replaces from_progress_status with the transform result. Actual selected per-source state/options are supplied by that result; this helper does not calculate quantity exhaustion or persist closure."
    }
