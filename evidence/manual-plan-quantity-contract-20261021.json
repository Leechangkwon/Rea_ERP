  "manualFindings": [
    {
      "id": "plan-adjust-workflow",
      "fact": "Plan list selection opens a separate quantity adjustment workflow; calculation options are applied in the popup and the adjustment is saved separately.",
      "source": "EC-PDF-INVENTORY-BEGINNER",
      "physicalPage": 21
    },
    {
      "id": "plan-adjust-options",
      "fact": "The six optional inputs concern outstanding sales, safety stock, stock on hand, outstanding receipts, minimum buying unit and outstanding material issue. The pictured dialog also has stock date/warehouse, business-cycle date and use of delivery date.",
      "source": "EC-PDF-INVENTORY-BEGINNER",
      "physicalPage": 21
    },
    {
      "id": "plan-adjust-defaults",
      "fact": "Calculation defaults are configured through the plan list Option menu. Minimum buying unit is an item quantity setting.",
      "source": "EC-PDF-INVENTORY-MID",
      "physicalPage": 18
    },
    {
      "id": "unknown-arithmetic",
      "fact": "Neither reviewed section gives a numerical minimum-unit example or proves ceil-to-multiple versus minimum-clamp, negative need handling, fractional unit precision, or allocation across repeated item rows.",
      "source": "both"
    }
  ],
  "staticFindings": [
    {
      "symbol": "onFooterQty",
      "fact": "Rejects empty selection; checks permitted dates, deduplicates vouchers for version checks, and opens the Qty popup only after successful preflight. Selected lines carry serial keys; the other branch sends zero serial."
    },
    {
      "symbol": "checkLimitSlipDetails",
      "fact": "For finalSearchParam.SEARCH_TYPE != 0, asks CheckLimitCountSale060DetailCal for detail count before version validation. (count || 501) > 500 blocks; missing/zero also falls back to blocked. This is not evidence of a universal 500-line rule for all list modes."
    },
    {
      "symbol": "checkMultiVertion",
      "fact": "Calls MultiCheckSlipVersion with voucher date/number/version groups and PURCHASEPLAN; actual server response behavior was not executed."
    }
  ],
  "ownGaps": [
    {
      "file": "dist/purchasing-plan-list-ui.js",
      "line": 32,
      "fact": "Footer has manual row edit/save and plan-to-order generation, but no quantity-adjust calculation flow."
    },
    {
      "file": "dist/entry-core.js",
      "line": 52,
      "fact": "stockCandidates computes stock plus pending receipts minus pending sales and safety shortage for draft import; no minPurchaseQty or material-issue contribution, no independent six-option calculation, not a saved-plan bulk adjustment."
    },
    {
      "file": "dist/item-core.js",
      "fact": "minPurchaseQty registration exists; changing safety import to apply it implicitly would be a new unconfirmed rule."
    }
  ],
