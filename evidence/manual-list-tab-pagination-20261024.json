  "originalContracts": {
    "gridForward": "Active tabId selects action_data; complete truthy sid/code/name tuple sets progress_status, otherwise assigns undefined; confirm_type is copied. Empty confirm_type expands nonempty menu progress_status.tab_data values joined with U+222C, when available.",
    "reverse": "Strict confirm_type and progress_status.sid match chooses first tab; otherwise first confirm_type empty tab; active becomes target tabId or undefined.",
    "progressStatusSearch": "Sets page.current_index to 1, deletes search_options.sort, copies payload progress_status/confirm_type. The local fix changes page only; local sort is preserved.",
    "pipeline": "modifySearchOptionResolvers$2 routes PROGRESS_STATUS to the resolver; getPrepareProcessResolvers$3 then includes ChangeListTabStateResolver. Kanban delegates its projection to a separate common resolver.",
    "limitations": "No actual menu metadata/body/current original UI or server-save acceptance. Static code was not executed and no original API called."
