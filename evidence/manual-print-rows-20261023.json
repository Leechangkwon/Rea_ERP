  "staticFindings": [
    {
      "scope": "row_count_dlt_feature_config",
      "finding": "Returns without assigning for List/Input menu types. Otherwise forwards row_count to data_generator.page_count. This does not prove the current purchase-order setting binding or whether the consumer counts logical items/physical lines/pages."
    },
    {
      "scope": "header_row_cnt_dlt_feature_config",
      "finding": "Forwards the attribute to data_generator.header_rows_per_page; the actual label mapping to header replacement-row count is unproven."
    },
    {
      "scope": "footer_row_cnt_dlt_feature_config",
      "finding": "Forwards the attribute to data_generator.footer_rows_per_page independently of header rows; not an observed footer-setting procedure."
    },
    {
      "scope": "remove_empty_line_dlt_feature_config",
      "finding": "Sets empty_line.is_remove and supplies an empty row model only when removal is explicitly false. It does not calculate a filler count or establish the replacement-row rule."
    }
  ],
  "excludedMisinterpretations": [
    "Generic input default_row_height or line_cnt/hide_tf is not purchase-order display-row-count evidence.",
    "Lookup page.row_count and PDF entry total-row safety limits are not page print-row settings.",
