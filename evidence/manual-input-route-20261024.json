  "findings": [
    {
      "scope": "previously established inventory projection, revalidated rather than reanalyzed",
      "fact": "ConvertSearchConditionV3Program forwards inv_s$data_input_type as INFLOW. The shared render-items resolver refers to the separately supplied data_input_type_search resource and checkbox/all metadata. CtxRuntimeBase current context defaults to I/Web, which is not proof of historical document origin.",
      "originalScopesReused": 4,
      "remainingGate": "Actual resource values, menu availability/default/empty/all semantics, creation assignment and preservation on edit, server filter/permission/persistence."
    },
    {
      "scope": "retained common upload guards",
      "fact": "CheckValidRowProgram/SlipDetailRowFilterAttrProgram/CheckDataUploadProgram distinguish EN_DATA_INPUT_TYPE B(DataUpLoad), E(DataUploadExcel), A(Api). These are flow contexts, not a complete enum or purchase search-option mapping.",
      "policy": "Do not copy original upload/API validation skip into the independent application."
    },
    {
      "scope": "account query bridge only",
      "fact": "ConvertSearchConditionV3AccountProgram gets the data_input_type refer-type value, concatenates selected values with U+222C, and sends INFLOW.",
      "purchaseEquivalentProven": false
    },
    {
      "scope": "retained inventory search layout string",
      "fact": "The observed inv_s$data_input_type field block is inside an HTML comment referring to an unsupported option converter. It does not prove a rendered purchase search control."
    },
    {
      "scope": "own deployed 0.88.14",
      "fact": "docFilters has no input-route selector. saveDoc clones the input and preserves quantity-link/source semantics. stageDocuments(copy) can produce a document without sourceId, as can a direct document command. sourceId is not an input-channel indicator."
    },
    {
      "scope": "own web upload review",
      "fact": "The deployed request upload UI is a review-only flow and does not save business documents. It cannot provide saved upload-origin fixtures or original channel defaults."
    }
